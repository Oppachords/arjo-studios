# =============================================================================
# ARJO STUDIOS — External Service Requirements
# Copy this file to .env.local for local dev, then add the same vars in Vercel.
# =============================================================================

# --- Admin Login (required) ---
ADMIN_USERNAME=Admin
ADMIN_PASSWORD=Arjo256@
JWT_SECRET=generate-a-long-random-string-at-least-32-chars

# --- Supabase (required) — via Vercel Supabase integration or supabase.com ---
# Vercel auto-provides: SUPABASE_URL, SUPABASE_SERVICE_ROLE_KEY, POSTGRES_URL, etc.
# The API uses SUPABASE_URL + SUPABASE_SERVICE_ROLE_KEY only.
# After first deploy, run supabase/schema.sql then supabase/seed.sql in Supabase SQL Editor
# (or use psql with POSTGRES_URL_NON_POOLING).
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Cloudinary (required for admin uploads) — https://cloudinary.com ---
# 1. Create a free account
# 2. Dashboard → copy Cloud name, API Key, API Secret
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
